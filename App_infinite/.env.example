MONGODB_URL=mongodb://dev:dev@127.0.0.1:27017/myapp?authSource=admin
# Tests create and clean up uniquely named databases on this local server.
MONGODB_TEST_URL=mongodb://dev:dev@127.0.0.1:27017/?authSource=admin

# Local development frontend; dev keeps the API on internal port 4000.
# Production preview overrides these to localhost:3000 in a single process.
HOST=127.0.0.1
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
