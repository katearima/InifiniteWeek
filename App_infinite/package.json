{
  "overrides": {
    "bson": "7.2.0"
  },
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.4",
  "dependencies": {
    "@mit-sdg/sync-engine": "1.1.0",
    "@mit-sdg/sync-engine-http": "1.1.0",
    "mongodb": "^7.7.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "typescript": ">=6 <7",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.0.0"
  },
  "scripts": {
    "generate": "sync-engine artifacts pin",
    "check": "sync-engine check && sync-engine artifacts check && tsc --noEmit",
    "start": "bun run --parallel start:backend start:frontend",
    "check:design": "sync-engine check-design design/concepts/*.md design/types.md design/compositions/*.md design/compositions/reusable/*.md",
    "dev": "bun run db:up && bun run --parallel dev:backend dev:frontend",
    "dev:backend": "PUBLIC_ORIGIN=${PUBLIC_ORIGIN:-http://localhost:8080} HOST=127.0.0.1 PORT=4000 bun --watch src/main.ts",
    "dev:frontend": "BACKEND_URL=http://127.0.0.1:4000 bun --watch web/server.ts",
    "up": "podman compose up -d --build && bun scripts/check-api.ts http://127.0.0.1:8080 --wait",
    "down": "podman compose down",
    "logs": "podman compose logs backend frontend",
    "db:up": "podman compose up -d --wait mongo",
    "db:shell": "podman compose exec mongo mongosh -u dev -p dev",
    "db:logs": "podman compose logs mongo",
    "db:reset": "podman compose down -v",
    "test:concepts": "bun test tests/concepts",
    "test:persistence": "bun scripts/check-persistence.ts",
    "test:compositions": "bun test tests/compositions",
    "test:http": "bun test tests/http",
    "start:backend": "PUBLIC_ORIGIN=${PUBLIC_ORIGIN:-http://localhost:8080} HOST=127.0.0.1 PORT=4000 bun src/main.ts",
    "start:frontend": "BACKEND_URL=http://127.0.0.1:4000 bun web/server.ts",
    "test:frontend": "bun test tests/frontend"
  }
}
